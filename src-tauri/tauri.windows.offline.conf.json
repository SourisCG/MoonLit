{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SourisCG",
    "homepage": "https://github.com/SourisCG/MoonLit",
    "category": "Video",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "useLocalToolsDir": true,
    "resources": {
      "target/package-stage/windows-x86_64/runtime/obs/": "runtime/obs/"
    },
    "windows": {
      "allowDowngrades": false,
      "bundleVCRuntime": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "MoonLit",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
