{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "moonlit-coordinator",
  "subagent_depth": 1,
  "share": "disabled",
  "snapshot": true,
  "instructions": [
    ".opencode/MOONLIT_AGENT_PROTOCOL.md"
  ],
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "target/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6
  }
}
